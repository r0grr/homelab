# ==============================================================================
# CADDY WEBSERVER & REVERSE PROXY
# TempsCat & MeteoSallent (Weather34)
# ==============================================================================

# ==============================================================================
# REDIRECCIÓ OFICIAL: meteosallent.com -> tempscat.com
# ==============================================================================
http://meteosallent.com, http://www.meteosallent.com, meteosallent.com, www.meteosallent.com {
    redir https://www.tempscat.com{uri} 301
}

# ==============================================================================
# DOMINI PÚBLIC OFICIAL TEMPSCAT
# ==============================================================================
http://tempscat.com, http://www.tempscat.com, tempscat.com, www.tempscat.com {
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }

    # Compressió d'actius web i HTML per a màxima velocitat (Google PageSpeed / Core Web Vitals)
    encode zstd gzip

    # Control estricte de mètodes HTTP: només es permeten GET, POST i HEAD
    @disallowed_methods {
        not method GET POST HEAD
    }
    respond @disallowed_methods "Mètode no permès" 405

    # Bloqueig de seguretat: fitxers de configuració i claus des d'Internet
    @blocked {
        path /easyweathersetup.php* /settings.php* /settings1.php*
    }
    respond @blocked "Accés prohibit" 403

    # Bloqueig de fitxers de configuració sensibles i scripts executables
    @sensitive_files {
        path *.env* *.ini *.conf *.sh *.sql *.bak *.yaml *.yml
    }
    respond @sensitive_files "Accés prohibit" 403

    # Bloqueig d'escanejadors i bots maliciosos (drop immediat per estalviar recursos)
    @scanners {
        path /.git* /.env* /wp-* /wordpress* /blog* /xmlrpc.php* /phpmyadmin* /pma* /.vscode* /.aws*
    }
    abort @scanners

    # Eliminació de capçaleres per seguretat (ocultar programari, proxy i versió)
    header {
        -Server
        -Via
        -X-Powered-By
    }

    # Redireccions d'enllaços externs heretats (Legacy VWS / Meteoclimatic)
    @sqv {
        path /santquirze/meteoclimatic.html* /santquirze/meteoclimatic.htm*
    }
    redir @sqv https://sqv.tempscat.com/meteoclimatic.html 301

    @legacy_vws {
        path /sallent/dades/vws/UV_solar.htm* /sallent/dades/vws/temperatura.htm* /sallent/dades/vws/pluja.htm* /sallent/dades/vws/detalls_MSCC.htm*
    }
    redir @legacy_vws / 301

    # Redirecció cap a la web de l'estació meteorològica
    reverse_proxy weather34:80 {
        header_down -Server
        header_down -Via
        header_down -X-Powered-By
    }
}

# ==============================================================================
# BLOQUEIG TOTAL DYNDNS (sallent.dyndns.org)
# ==============================================================================
http://sallent.dyndns.org, sallent.dyndns.org {
    abort
}

# ==============================================================================
# PANELL PRIVAT D'ANALÍTICA WEB GOACCESS (Intern: LAN / Tailscale)
# ==============================================================================
:7880 {
    root * /srv/goaccess
    file_server
}

:8443 {
    tls /etc/caddy/certs/vaultwarden.crt /etc/caddy/certs/vaultwarden.key
    @deny_dyndns {
        header Host *sallent.dyndns*
    }
    abort @deny_dyndns
    reverse_proxy vaultwarden:80
}

